# Copy to .env. Never commit .env.
# Everything is optional: with no keys the stack runs in screening-only mode
# (GuardianAI transaction screening, exchange rates, health). Investigations need OpenAI.

# --- LLM features (multi-agent investigation, research, document search) ---
OPENAI_API_KEY=
# Web search tool used by the research agent
TAVILY_SEARCH_API_KEY=
# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=InvestigatorAI-Local

# --- Models ---
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000

# --- GuardianAI screening ---
# Weighted risk score above this is flagged as fraud and escalated (0.3 = best accuracy on bundled data)
GUARDIAN_FRAUD_THRESHOLD=0.3

# --- Host ports ---
API_PORT=8000
WEB_PORT=3000
QDRANT_PORT=6333
